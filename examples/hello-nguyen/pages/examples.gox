---
layout = "app/layout"

export const metadata = {
    title: "Examples — Nguyen.go",
    description: "Real-world apps built with Nguyen.go. Clone, study, ship.",
}

export const geo = {
    pageType: "CollectionPage",
    datePublished: "2026-05-01T00:00:00Z",
    dateModified: "2026-05-10T00:00:00Z",
    author: "Nguyen.go Team",
    breadcrumbs: [
        { name: "Home", url: "/" },
        { name: "Examples", url: "/examples" },
    ],
}
---
<!-- ============================================
     HEADER
     ============================================ -->
<section class="relative">
    <div class="hero-glow" style="opacity:0.5"></div>
    <div class="max-w-6xl mx-auto px-6 pt-28 pb-16 relative">
        <div class="flex items-center gap-2 text-[13px] text-muted mb-6">
            <nguyen-link href="/" class="hover:text-white transition-colors">Home</nguyen-link>
            <svg width="10" height="10" viewBox="0 0 16 16" fill="none" class="opacity-50"><path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <span class="text-muted-stronger">Examples</span>
        </div>

        <p class="text-[13px] text-blue font-mono uppercase tracking-widest mb-4">Examples</p>
        <h1 class="heading-lg text-white mb-4" style="font-size:clamp(2.5rem,5vw,3.75rem)">
            <span class="gradient-text">Real apps.<br/>Real code. Clone and ship.</span>
        </h1>
        <p class="text-[17px] text-muted max-w-2xl leading-relaxed">
            Every example is a complete, production-ready project. Clone the repo, run <code class="text-blue font-mono text-[15px]">nguyen dev</code>, and learn by reading the code.
        </p>

        <div class="flex items-center gap-3 mt-8 flex-wrap">
            <nguyen-link href="https://github.com/dev2k6/Nguyen.go" class="btn btn-blue">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
                View on GitHub
            </nguyen-link>
            <nguyen-link href="/showcase" class="btn btn-secondary">
                See live showcases
            </nguyen-link>
        </div>
    </div>
</section>

<!-- ============================================
     CATEGORY PILLS
     ============================================ -->
<section class="max-w-6xl mx-auto px-6 pb-10">
    <div class="flex items-center gap-2 flex-wrap">
        <button class="pill pill-blue">All (12)</button>
        <button class="pill">Starter (4)</button>
        <button class="pill">Blog (2)</button>
        <button class="pill">E-commerce (2)</button>
        <button class="pill">Dashboard (2)</button>
        <button class="pill">API (2)</button>
    </div>
</section>

<!-- ============================================
     EXAMPLES GRID
     ============================================ -->
<section class="max-w-6xl mx-auto px-6 pb-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">

        <!-- Example 1: Hello World -->
        <a href="https://github.com/dev2k6/Nguyen.go/tree/main/hello-nguyen" class="card card-blue-hover block overflow-hidden">
            <div class="aspect-[16/10] relative overflow-hidden" style="background:linear-gradient(135deg,rgba(0,112,243,0.15),rgba(96,165,250,0.03))">
                <div class="absolute inset-0 grid-lines" style="opacity:0.5"></div>
                <div class="absolute inset-0 flex items-center justify-center">
                    <svg width="52" height="52" viewBox="0 0 24 24" fill="none" style="opacity:0.7"><path d="M12 2L21.66 7.5V16.5L12 22L2.34 16.5V7.5L12 2Z" fill="url(#e1)"/><defs><linearGradient id="e1" x1="12" y1="2" x2="12" y2="22"><stop stop-color="#ffffff"/><stop offset="1" stop-color="#0070f3"/></linearGradient></defs></svg>
                </div>
                <div class="absolute top-3 left-3">
                    <span class="pill pill-blue">
                        <span class="pill-dot"></span>
                        Starter
                    </span>
                </div>
            </div>
            <div class="p-6">
                <h3 class="text-[17px] font-semibold tracking-tight text-white mb-2">Hello Nguyen.go</h3>
                <p class="text-[13px] text-muted leading-relaxed mb-4">The canonical first project. Counter, routing, SSR, and hydration — all in 3 pages.</p>
                <div class="flex items-center gap-3 text-[12px] text-muted">
                    <span class="flex items-center gap-1">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                        1.2k
                    </span>
                    <span>TinyGo</span>
                </div>
            </div>
        </a>

        <!-- Example 2: Blog -->
        <a href="https://github.com/dev2k6/Nguyen.go/tree/main/blog" class="card card-blue-hover block overflow-hidden">
            <div class="aspect-[16/10] relative overflow-hidden" style="background:linear-gradient(135deg,rgba(168,85,247,0.15),rgba(192,132,252,0.03))">
                <div class="absolute inset-0 grid-lines" style="opacity:0.5"></div>
                <div class="absolute inset-0 flex items-center justify-center">
                    <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="#c084fc" stroke-width="1.5" style="opacity:0.7"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                </div>
                <div class="absolute top-3 left-3">
                    <span class="pill">Blog</span>
                </div>
            </div>
            <div class="p-6">
                <h3 class="text-[17px] font-semibold tracking-tight text-white mb-2">Markdown blog with ISR</h3>
                <p class="text-[13px] text-muted leading-relaxed mb-4">Static blog with MDX-like content collections, syntax highlighting, and 60s ISR.</p>
                <div class="flex items-center gap-3 text-[12px] text-muted">
                    <span class="flex items-center gap-1">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                        876
                    </span>
                    <span>ISR</span>
                </div>
            </div>
        </a>

        <!-- Example 3: E-commerce -->
        <a href="https://github.com/dev2k6/Nguyen.go/tree/main/shop" class="card card-blue-hover block overflow-hidden">
            <div class="aspect-[16/10] relative overflow-hidden" style="background:linear-gradient(135deg,rgba(52,211,153,0.15),rgba(16,185,129,0.03))">
                <div class="absolute inset-0 grid-lines" style="opacity:0.5"></div>
                <div class="absolute inset-0 flex items-center justify-center">
                    <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="1.5" style="opacity:0.7"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                </div>
                <div class="absolute top-3 left-3">
                    <span class="pill">E-commerce</span>
                </div>
            </div>
            <div class="p-6">
                <h3 class="text-[17px] font-semibold tracking-tight text-white mb-2">Storefront</h3>
                <p class="text-[13px] text-muted leading-relaxed mb-4">Product grid, filter, cart with persisted state, Stripe checkout.</p>
                <div class="flex items-center gap-3 text-[12px] text-muted">
                    <span class="flex items-center gap-1">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                        542
                    </span>
                    <span>SSR + Islands</span>
                </div>
            </div>
        </a>

        <!-- Example 4: Dashboard -->
        <a href="https://github.com/dev2k6/Nguyen.go/tree/main/dashboard" class="card card-blue-hover block overflow-hidden">
            <div class="aspect-[16/10] relative overflow-hidden" style="background:linear-gradient(135deg,rgba(251,146,60,0.15),rgba(234,88,12,0.03))">
                <div class="absolute inset-0 grid-lines" style="opacity:0.5"></div>
                <div class="absolute inset-0 flex items-center justify-center">
                    <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="#fb923c" stroke-width="1.5" style="opacity:0.7"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                </div>
                <div class="absolute top-3 left-3">
                    <span class="pill">Dashboard</span>
                </div>
            </div>
            <div class="p-6">
                <h3 class="text-[17px] font-semibold tracking-tight text-white mb-2">Admin dashboard</h3>
                <p class="text-[13px] text-muted leading-relaxed mb-4">Auth-gated SPA with real-time charts, data tables, and a sidebar nav.</p>
                <div class="flex items-center gap-3 text-[12px] text-muted">
                    <span class="flex items-center gap-1">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                        398
                    </span>
                    <span>CSR + Auth</span>
                </div>
            </div>
        </a>

        <!-- Example 5: API -->
        <a href="https://github.com/dev2k6/Nguyen.go/tree/main/rest-api" class="card card-blue-hover block overflow-hidden">
            <div class="aspect-[16/10] relative overflow-hidden" style="background:linear-gradient(135deg,rgba(236,72,153,0.15),rgba(219,39,119,0.03))">
                <div class="absolute inset-0 grid-lines" style="opacity:0.5"></div>
                <div class="absolute inset-0 flex items-center justify-center">
                    <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="#ec4899" stroke-width="1.5" style="opacity:0.7"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                </div>
                <div class="absolute top-3 left-3">
                    <span class="pill">API</span>
                </div>
            </div>
            <div class="p-6">
                <h3 class="text-[17px] font-semibold tracking-tight text-white mb-2">REST API + OpenAPI</h3>
                <p class="text-[13px] text-muted leading-relaxed mb-4">File-based API routes, auto-generated OpenAPI spec, typed request bodies.</p>
                <div class="flex items-center gap-3 text-[12px] text-muted">
                    <span class="flex items-center gap-1">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                        311
                    </span>
                    <span>Fiber</span>
                </div>
            </div>
        </a>

        <!-- Example 6: Chat -->
        <a href="https://github.com/dev2k6/Nguyen.go/tree/main/chat" class="card card-blue-hover block overflow-hidden">
            <div class="aspect-[16/10] relative overflow-hidden" style="background:linear-gradient(135deg,rgba(250,204,21,0.15),rgba(234,179,8,0.03))">
                <div class="absolute inset-0 grid-lines" style="opacity:0.5"></div>
                <div class="absolute inset-0 flex items-center justify-center">
                    <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="#facc15" stroke-width="1.5" style="opacity:0.7"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                </div>
                <div class="absolute top-3 left-3">
                    <span class="pill">Realtime</span>
                </div>
            </div>
            <div class="p-6">
                <h3 class="text-[17px] font-semibold tracking-tight text-white mb-2">Realtime chat</h3>
                <p class="text-[13px] text-muted leading-relaxed mb-4">WebSocket rooms, typing indicators, persistence with SQLite.</p>
                <div class="flex items-center gap-3 text-[12px] text-muted">
                    <span class="flex items-center gap-1">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                        264
                    </span>
                    <span>WebSocket</span>
                </div>
            </div>
        </a>
    </div>
</section>

<!-- ============================================
     CLI CLONE HINT
     ============================================ -->
<section class="max-w-3xl mx-auto px-6 pb-24">
    <div class="card p-8 text-center">
        <p class="text-[13px] text-blue font-mono uppercase tracking-widest mb-3">Clone any example</p>
        <h3 class="text-[22px] font-semibold tracking-tight text-white mb-5">
            One command. You're running in seconds.
        </h3>
        <div class="cmd-block max-w-md mx-auto">
            <span class="cmd-prompt">$</span>
            <span class="cmd-text">nguyen create my-app --template=shop</span>
        </div>
        <p class="text-[13px] text-muted mt-4">
            Templates are pulled from the official <a href="https://github.com/dev2k6/Nguyen.go" class="text-blue hover:opacity-80">examples repo</a>.
        </p>
    </div>
</section>
