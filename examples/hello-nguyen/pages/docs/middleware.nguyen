---
layout = "app/layout"

export const metadata = {
    title: "Middleware — Nguyen.go",
    description: "Add middleware for auth, logging, headers, and more to your Nguyen.go application.",
}

export const geo = {
    pageType: "TechArticle",
    datePublished: "2026-05-01T00:00:00Z",
    dateModified: "2026-05-10T00:00:00Z",
    author: "Nguyen.go Team",
    breadcrumbs: [
        { name: "Home", url: "/" },
        { name: "Docs", url: "/docs" },
        { name: "Middleware", url: "/docs/middleware" },
    ],
}
---
<section class="max-w-4xl mx-auto px-6 pt-24 pb-16">
    <div class="flex items-center gap-2 text-[13px] text-muted mb-6">
        <nguyen-link href="/" class="hover:text-white transition-colors">Home</nguyen-link>
        <svg width="10" height="10" viewBox="0 0 16 16" fill="none" class="opacity-50"><path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <nguyen-link href="/docs" class="hover:text-white transition-colors">Docs</nguyen-link>
        <svg width="10" height="10" viewBox="0 0 16 16" fill="none" class="opacity-50"><path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <span class="text-muted-stronger">Middleware</span>
    </div>

    <p class="text-[13px] text-blue font-mono uppercase tracking-widest mb-4">Advanced</p>
    <h1 class="text-[36px] font-semibold tracking-tight text-white mb-4">Middleware</h1>
    <p class="text-[17px] text-muted max-w-2xl leading-relaxed mb-12">
        Middleware runs before your page or API handler. Use it for authentication, logging, CORS, rate limiting, and custom headers.
    </p>

    <div class="space-y-10">
        <div>
            <h2 class="text-[22px] font-semibold tracking-tight text-white mb-4">Built-in middleware</h2>
            <p class="text-[16px] text-muted leading-[1.75] mb-4">
                Nguyen.go ships with common middleware out of the box:
            </p>
            <div class="card overflow-hidden mb-4">
                <table class="cmp-table">
                    <thead>
                        <tr>
                            <th class="!text-left">Middleware</th>
                            <th class="!text-left">Purpose</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="font-mono text-blue text-[13px]">Logger</td>
                            <td class="text-muted-stronger">Request logging with timing</td>
                        </tr>
                        <tr>
                            <td class="font-mono text-blue text-[13px]">CORS</td>
                            <td class="text-muted-stronger">Cross-origin resource sharing headers</td>
                        </tr>
                        <tr>
                            <td class="font-mono text-blue text-[13px]">Compress</td>
                            <td class="text-muted-stronger">Gzip/Brotli response compression</td>
                        </tr>
                        <tr>
                            <td class="font-mono text-blue text-[13px]">RateLimit</td>
                            <td class="text-muted-stronger">Per-IP request throttling</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div>
            <h2 class="text-[22px] font-semibold tracking-tight text-white mb-4">Custom middleware</h2>
            <p class="text-[16px] text-muted leading-[1.75] mb-4">
                Write your own middleware using the standard Fiber handler signature:
            </p>
            <div class="terminal mb-4">
                <div class="terminal-bar">
                    <span class="terminal-dot"></span><span class="terminal-dot"></span><span class="terminal-dot"></span>
                    <span class="ml-3 text-[12px] font-mono text-muted">middleware/auth.go</span>
                </div>
                <pre class="terminal-body text-[#c9d1d9]"><span style="color:#ff7b72">func</span> <span style="color:#d2a8ff">AuthMiddleware</span>(c *fiber.<span style="color:#79c0ff">Ctx</span>) <span style="color:#ff7b72">error</span> {
    <span style="color:#79c0ff">token</span> := c.<span style="color:#d2a8ff">Get</span>(<span style="color:#a5d6ff">"Authorization"</span>)
    <span style="color:#ff7b72">if</span> token == <span style="color:#a5d6ff">""</span> {
        <span style="color:#ff7b72">return</span> c.<span style="color:#d2a8ff">Status</span>(<span style="color:#79c0ff">401</span>).<span style="color:#d2a8ff">JSON</span>(fiber.<span style="color:#79c0ff">Map</span>{
            <span style="color:#a5d6ff">"error"</span>: <span style="color:#a5d6ff">"unauthorized"</span>,
        })
    }
    <span style="color:#ff7b72">return</span> c.<span style="color:#d2a8ff">Next</span>()
}</pre>
            </div>
        </div>

        <div>
            <h2 class="text-[22px] font-semibold tracking-tight text-white mb-4">Route guards</h2>
            <p class="text-[16px] text-muted leading-[1.75]">
                Add <code class="text-blue font-mono text-[14px]">guard = "auth"</code> in your page frontmatter to apply middleware to specific routes. The guard name maps to a registered middleware function.
            </p>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-16">
        <nguyen-link href="/docs/api-routes" class="card card-blue-hover block">
            <div style="padding:1rem 1.25rem;">
                <div class="text-[12px] text-muted mb-2 flex items-center gap-1">
                    <svg width="12" height="12" viewBox="0 0 16 16" fill="none"><path d="M10 3L5 8L10 13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    Previous
                </div>
                <div class="text-[15px] font-medium text-white">API routes</div>
            </div>
        </nguyen-link>
        <nguyen-link href="/docs/deployment" class="card card-blue-hover block">
            <div class="text-right" style="padding:1rem 1.25rem;">
                <div class="text-[12px] text-muted mb-2 flex items-center gap-1 justify-end">
                    Next
                    <svg width="12" height="12" viewBox="0 0 16 16" fill="none"><path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                </div>
                <div class="text-[15px] font-medium text-white">Deployment</div>
            </div>
        </nguyen-link>
    </div>
</section>
