---
layout = "app/layout"

export const metadata = {
    title: "Installation — Nguyen.go",
    description: "Install the Nguyen.go CLI and create your first project in under 30 seconds.",
}

export const geo = {
    pageType: "TechArticle",
    datePublished: "2026-05-01T00:00:00Z",
    dateModified: "2026-05-10T00:00:00Z",
    author: "Nguyen.go Team",
    breadcrumbs: [
        { name: "Home", url: "/" },
        { name: "Docs", url: "/docs" },
        { name: "Installation", url: "/docs/installation" },
    ],
}
---
<section class="max-w-4xl mx-auto px-6 pt-24 pb-16">
    <div class="flex items-center gap-2 text-[13px] text-muted mb-6">
        <nguyen-link href="/" class="hover:text-white transition-colors">Home</nguyen-link>
        <svg width="10" height="10" viewBox="0 0 16 16" fill="none" class="opacity-50"><path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <nguyen-link href="/docs" class="hover:text-white transition-colors">Docs</nguyen-link>
        <svg width="10" height="10" viewBox="0 0 16 16" fill="none" class="opacity-50"><path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <span class="text-muted-stronger">Installation</span>
    </div>

    <p class="text-[13px] text-blue font-mono uppercase tracking-widest mb-4">Getting started</p>
    <h1 class="text-[36px] font-semibold tracking-tight text-white mb-4">Installation</h1>
    <p class="text-[17px] text-muted max-w-2xl leading-relaxed mb-12">
        Get up and running with Nguyen.go in two commands. No Node.js, no npm, no lockfiles.
    </p>

    <div class="space-y-10">
        <div>
            <h2 class="text-[22px] font-semibold tracking-tight text-white mb-4">Prerequisites</h2>
            <p class="text-[16px] text-muted leading-[1.75] mb-4">
                You need <code class="text-blue font-mono text-[14px]">Go 1.21+</code> installed on your machine. Verify with:
            </p>
            <div class="terminal mb-4">
                <div class="terminal-bar">
                    <span class="terminal-dot"></span><span class="terminal-dot"></span><span class="terminal-dot"></span>
                    <span class="ml-3 text-[12px] font-mono text-muted">terminal</span>
                </div>
                <pre class="terminal-body text-[#c9d1d9]"><span style="color:#79c0ff">$</span> go version
go version go1.22.3 linux/amd64</pre>
            </div>
        </div>

        <div>
            <h2 class="text-[22px] font-semibold tracking-tight text-white mb-4">Install the CLI</h2>
            <div class="terminal mb-4">
                <div class="terminal-bar">
                    <span class="terminal-dot"></span><span class="terminal-dot"></span><span class="terminal-dot"></span>
                    <span class="ml-3 text-[12px] font-mono text-muted">terminal</span>
                </div>
                <pre class="terminal-body text-[#c9d1d9]"><span style="color:#79c0ff">$</span> go install github.com/dev2k6/Nguyen.go/cmd/nguyen@latest</pre>
            </div>
            <p class="text-[16px] text-muted leading-[1.75]">
                This installs the <code class="text-blue font-mono text-[14px]">nguyen</code> binary into your <code class="text-blue font-mono text-[14px]">$GOPATH/bin</code>. Make sure it's in your PATH.
            </p>
        </div>

        <div>
            <h2 class="text-[22px] font-semibold tracking-tight text-white mb-4">Create a project</h2>
            <div class="terminal mb-4">
                <div class="terminal-bar">
                    <span class="terminal-dot"></span><span class="terminal-dot"></span><span class="terminal-dot"></span>
                    <span class="ml-3 text-[12px] font-mono text-muted">terminal</span>
                </div>
                <pre class="terminal-body text-[#c9d1d9]"><span style="color:#79c0ff">$</span> nguyen create my-app
<span style="color:#7ee787">✓</span> Created project at ./my-app

<span style="color:#79c0ff">$</span> cd my-app
<span style="color:#79c0ff">$</span> nguyen dev
<span style="color:#7ee787">✓</span> Dev server running at http://localhost:3000</pre>
            </div>
        </div>

        <div>
            <h2 class="text-[22px] font-semibold tracking-tight text-white mb-4">What you get</h2>
            <div class="terminal mb-4">
                <div class="terminal-bar">
                    <span class="terminal-dot"></span><span class="terminal-dot"></span><span class="terminal-dot"></span>
                    <span class="ml-3 text-[12px] font-mono text-muted">project structure</span>
                </div>
                <pre class="terminal-body text-[#c9d1d9]"><span style="color:#79c0ff">my-app/</span>
├── <span style="color:#79c0ff">app/</span>
│   └── <span style="color:#7ee787">layout.nguyen</span>
├── <span style="color:#79c0ff">pages/</span>
│   └── <span style="color:#7ee787">index.nguyen</span>
├── <span style="color:#79c0ff">public/</span>
├── <span style="color:#79c0ff">styles/</span>
│   └── <span style="color:#7ee787">input.css</span>
└── <span style="color:#7ee787">nguyen.config.yml</span></pre>
            </div>
        </div>

        <div class="card p-7" style="background:rgba(0,112,243,0.04);border-color:rgba(0,112,243,0.25)">
            <div class="flex items-start gap-4">
                <div class="feat-icon shrink-0" style="width:2rem;height:2rem;background:rgba(0,112,243,0.15);border-color:rgba(0,112,243,0.3)">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#60a5fa" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                </div>
                <div>
                    <h4 class="text-[14px] font-medium text-white mb-2">Troubleshooting</h4>
                    <p class="text-[14px] text-muted leading-relaxed">If <code class="text-blue font-mono text-[12px]">nguyen</code> is not found after install, run <code class="text-blue font-mono text-[12px]">export PATH=$PATH:$(go env GOPATH)/bin</code> or add it to your shell profile.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-16">
        <nguyen-link href="/docs" class="card card-blue-hover block">
            <div style="padding:1rem 1.25rem;">
                <div class="text-[12px] text-muted mb-2 flex items-center gap-1">
                    <svg width="12" height="12" viewBox="0 0 16 16" fill="none"><path d="M10 3L5 8L10 13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    Previous
                </div>
                <div class="text-[15px] font-medium text-white">Docs overview</div>
            </div>
        </nguyen-link>
        <nguyen-link href="/docs/project-structure" class="card card-blue-hover block">
            <div class="text-right" style="padding:1rem 1.25rem;">
                <div class="text-[12px] text-muted mb-2 flex items-center gap-1 justify-end">
                    Next
                    <svg width="12" height="12" viewBox="0 0 16 16" fill="none"><path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                </div>
                <div class="text-[15px] font-medium text-white">Project structure</div>
            </div>
        </nguyen-link>
    </div>
</section>
