---
layout = "app/layout"

export const metadata = {
    title: "Islands — Nguyen.go",
    description: "Partial hydration with Islands architecture in Nguyen.go — interactive components in a static shell.",
}

export const geo = {
    pageType: "TechArticle",
    datePublished: "2026-05-01T00:00:00Z",
    dateModified: "2026-05-10T00:00:00Z",
    author: "Nguyen.go Team",
    breadcrumbs: [
        { name: "Home", url: "/" },
        { name: "Docs", url: "/docs" },
        { name: "Islands", url: "/docs/islands" },
    ],
}
---
<section class="max-w-4xl mx-auto px-6 pt-24 pb-16">
    <div class="flex items-center gap-2 text-[13px] text-muted mb-6">
        <nguyen-link href="/" class="hover:text-white transition-colors">Home</nguyen-link>
        <svg width="10" height="10" viewBox="0 0 16 16" fill="none" class="opacity-50"><path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <nguyen-link href="/docs" class="hover:text-white transition-colors">Docs</nguyen-link>
        <svg width="10" height="10" viewBox="0 0 16 16" fill="none" class="opacity-50"><path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <span class="text-muted-stronger">Islands</span>
    </div>

    <p class="text-[13px] text-blue font-mono uppercase tracking-widest mb-4">Core concepts</p>
    <h1 class="text-[36px] font-semibold tracking-tight text-white mb-4">Islands</h1>
    <p class="text-[17px] text-muted max-w-2xl leading-relaxed mb-12">
        Islands let you ship zero JavaScript for static content while selectively hydrating interactive components. The best of both worlds.
    </p>

    <div class="space-y-10">
        <div>
            <h2 class="text-[22px] font-semibold tracking-tight text-white mb-4">How it works</h2>
            <p class="text-[16px] text-muted leading-[1.75] mb-4">
                By default, pages are rendered as static HTML with no client JS. When you need interactivity, mark a section as an island — only that section gets hydrated.
            </p>
            <div class="terminal mb-4">
                <div class="terminal-bar">
                    <span class="terminal-dot"></span><span class="terminal-dot"></span><span class="terminal-dot"></span>
                    <span class="ml-3 text-[12px] font-mono text-muted">template</span>
                </div>
                <pre class="terminal-body text-[#c9d1d9]"><span style="color:#6e7681">&lt;!-- Static: no JS shipped --&gt;</span>
&lt;<span style="color:#7ee787">header</span>&gt;Welcome to my site&lt;/<span style="color:#7ee787">header</span>&gt;

<span style="color:#6e7681">&lt;!-- Island: hydrated on client --&gt;</span>
&lt;<span style="color:#7ee787">div</span> <span style="color:#79c0ff">data-island</span>&gt;
  &lt;<span style="color:#7ee787">button</span> <span style="color:#79c0ff">@click</span>=<span style="color:#a5d6ff">"toggle()"</span>&gt;Toggle&lt;/<span style="color:#7ee787">button</span>&gt;
  &lt;<span style="color:#7ee787">p</span>&gt;{<span style="color:#79c0ff">status</span>}&lt;/<span style="color:#7ee787">p</span>&gt;
&lt;/<span style="color:#7ee787">div</span>&gt;

<span style="color:#6e7681">&lt;!-- Static again --&gt;</span>
&lt;<span style="color:#7ee787">footer</span>&gt;Copyright 2026&lt;/<span style="color:#7ee787">footer</span>&gt;</pre>
            </div>
        </div>

        <div>
            <h2 class="text-[22px] font-semibold tracking-tight text-white mb-4">When to use Islands</h2>
            <div class="card overflow-hidden mb-4">
                <table class="cmp-table">
                    <thead>
                        <tr>
                            <th class="!text-left">Use case</th>
                            <th class="!text-left">Approach</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="text-muted-stronger">Static marketing page</td>
                            <td class="text-muted-stronger">No islands needed — pure HTML</td>
                        </tr>
                        <tr>
                            <td class="text-muted-stronger">Page with one interactive widget</td>
                            <td class="text-muted-stronger">Wrap the widget in <code class="text-blue font-mono text-[12px]">data-island</code></td>
                        </tr>
                        <tr>
                            <td class="text-muted-stronger">Fully interactive app</td>
                            <td class="text-muted-stronger">Use hooks directly — the whole page hydrates</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div>
            <h2 class="text-[22px] font-semibold tracking-tight text-white mb-4">Performance benefits</h2>
            <p class="text-[16px] text-muted leading-[1.75]">
                Islands reduce the amount of JavaScript sent to the client. A page with 90% static content and one interactive counter only ships the hydration code for that counter — not the entire page.
            </p>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-16">
        <nguyen-link href="/docs/hooks" class="card card-blue-hover block">
            <div style="padding:1rem 1.25rem;">
                <div class="text-[12px] text-muted mb-2 flex items-center gap-1">
                    <svg width="12" height="12" viewBox="0 0 16 16" fill="none"><path d="M10 3L5 8L10 13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    Previous
                </div>
                <div class="text-[15px] font-medium text-white">Hooks</div>
            </div>
        </nguyen-link>
        <nguyen-link href="/docs/state" class="card card-blue-hover block">
            <div class="text-right" style="padding:1rem 1.25rem;">
                <div class="text-[12px] text-muted mb-2 flex items-center gap-1 justify-end">
                    Next
                    <svg width="12" height="12" viewBox="0 0 16 16" fill="none"><path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                </div>
                <div class="text-[15px] font-medium text-white">State management</div>
            </div>
        </nguyen-link>
    </div>
</section>
