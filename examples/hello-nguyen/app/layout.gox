---
// Root layout — wraps every page
func layoutProps() map[string]string {
    return map[string]string{
        "title": "Nguyen.go",
        "description": "The Go full-stack framework",
    }
}
---
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/public/favicon.ico" />
    <link rel="apple-touch-icon" href="/public/logo.png" />
    <meta property="og:image" content="/public/logo.png" />
    <meta name="twitter:image" content="/public/logo.png" />
    <link rel="stylesheet" href="/styles/output.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <nguyen-head />
</head>
<body class="min-h-screen">
    <!-- Nav -->
    <header class="nav sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-6 h-14 flex items-center justify-between">
            <div class="flex items-center gap-8">
                <a href="/" class="hover:opacity-90 transition-opacity">
                    <img src="/public/logo.png" alt="Nguyen.go" style="height:60px;width:auto;max-width:none" />
                </a>
                <nav class="hidden md:flex items-center gap-6">
                    <nguyen-link href="/docs" class="text-[13px] text-muted hover:text-white transition-colors">Docs</nguyen-link>
                    <nguyen-link href="/blog" class="text-[13px] text-muted hover:text-white transition-colors">Blog</nguyen-link>
                    <nguyen-link href="/examples" class="text-[13px] text-muted hover:text-white transition-colors">Examples</nguyen-link>
                    <nguyen-link href="/showcase" class="text-[13px] text-muted hover:text-white transition-colors">Showcase</nguyen-link>
                </nav>
            </div>
            <div class="flex items-center gap-2">
                <a href="https://github.com/dev2k6/Nguyen.go" class="btn btn-ghost !h-8 !px-2" aria-label="GitHub">
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
                </a>
                <nguyen-link href="/docs" class="btn btn-primary !h-8 !px-3 !text-[12px]">Get Started</nguyen-link>
            </div>
        </div>
    </header>

    <main>
        <nguyen-slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-[var(--color-border)] mt-32">
        <div class="max-w-7xl mx-auto px-6 py-16">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
                <div>
                    <h4 class="text-[12px] font-medium text-muted-stronger uppercase tracking-wider mb-4">Resources</h4>
                    <ul class="space-y-2.5 text-[13px]">
                        <li><a href="/docs" class="text-muted hover:text-white transition-colors">Documentation</a></li>
                        <li><a href="/docs/api" class="text-muted hover:text-white transition-colors">API Reference</a></li>
                        <li><a href="/blog" class="text-muted hover:text-white transition-colors">Blog</a></li>
                        <li><a href="/examples" class="text-muted hover:text-white transition-colors">Examples</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="text-[12px] font-medium text-muted-stronger uppercase tracking-wider mb-4">Community</h4>
                    <ul class="space-y-2.5 text-[13px]">
                        <li><a href="https://github.com/dev2k6/Nguyen.go" class="text-muted hover:text-white transition-colors">GitHub</a></li>
                        <li><a href="#" class="text-muted hover:text-white transition-colors">Discord</a></li>
                        <li><a href="#" class="text-muted hover:text-white transition-colors">Twitter</a></li>
                        <li><a href="#" class="text-muted hover:text-white transition-colors">Showcase</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="text-[12px] font-medium text-muted-stronger uppercase tracking-wider mb-4">Company</h4>
                    <ul class="space-y-2.5 text-[13px]">
                        <li><a href="/about" class="text-muted hover:text-white transition-colors">About</a></li>
                        <li><a href="/privacy" class="text-muted hover:text-white transition-colors">Privacy</a></li>
                        <li><a href="/terms" class="text-muted hover:text-white transition-colors">Terms</a></li>
                        <li><a href="/contact" class="text-muted hover:text-white transition-colors">Contact</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="text-[12px] font-medium text-muted-stronger uppercase tracking-wider mb-4">Legal</h4>
                    <ul class="space-y-2.5 text-[13px]">
                        <li><a href="/terms" class="text-muted hover:text-white transition-colors">Terms of Service</a></li>
                        <li><a href="/privacy" class="text-muted hover:text-white transition-colors">Privacy Policy</a></li>
                        <li><a href="/cookies" class="text-muted hover:text-white transition-colors">Cookie Policy</a></li>
                    </ul>
                </div>
            </div>
            <div class="pt-8 mt-12 border-t border-[var(--color-border)] flex items-center justify-between flex-wrap gap-3 text-[12px] text-muted">
                <span>© 2026 Nguyen.go. Built with Go and WebAssembly.</span>
                <div class="flex items-center gap-3">
                    <span class="pill pill-blue !h-5 !text-[10px] !px-2">
                        <span class="pill-dot !w-1 !h-1"></span>
                        v0.1.0
                    </span>
                    <span>All systems operational</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="/bridge/nguyen_bridge.js" type="module"></script>
</body>
</html>
